FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1     PYTHONUNBUFFERED=1     JARVIS_DATA_DIR=/var/data     JARVIS_AGENT_POLL_SECONDS=12     JARVIS_AGENT_MAX_STEPS_PER_WAKE=4

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY jarvis_agent_release_v200.py .
RUN echo "022bc627ff740c281917ddf830e1206706e5a0e4c7293a9b87bdd5eaed1e4f80  jarvis_agent_release_v200.py" | sha256sum -c -
RUN python jarvis_agent_release_v200.py
RUN python -m compileall -q app

# Build must fail unless the actual agent-first architecture is present.
RUN grep -q "ACTIVE_RELEASE_FILE = 'jarvis_agent_release_v200.py'" app/self_maintenance.py
RUN grep -q "def run_objective" app/agent_runtime_v2.py
RUN grep -q "independent verifier" app/agent_runtime_v2.py
RUN grep -q "persistent objective" app/agent_console.py
RUN grep -q "/agent/command" app/agent_console.py
RUN grep -q "/jarvis/legacy" app/agent_console.py
RUN grep -q "agent_runtime_start" app/main.py
RUN grep -q "AGENT_CONSOLE_HTML" app/main.py
RUN grep -q "knowledge_chunks" app/documents.py
RUN grep -q "Marin" app/jarvis_dashboard.py

RUN python -m app.seed_panther
CMD ["sh","-c","uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
