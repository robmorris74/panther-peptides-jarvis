FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVIS_DATA_DIR=/var/data \
    DATABASE_PATH=/var/data/operator.db \
    JARVIS_CONFIG_PATH=/var/data/jarvis.env \
    JARVIS_KEY_PATH=/var/data/jarvis.key \
    JARVIS_SESSION_DB=/var/data/jarvis_sessions.db \
    JARVIS_AGENT_POLL_SECONDS=12 \
    JARVIS_AGENT_MAX_STEPS_PER_WAKE=4 \
    JARVIS_SQLITE_BUSY_TIMEOUT_MS=30000 \
    JARVIS_SQLITE_WRITE_RETRIES=8

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY jarvis_agent_release_v209.py .
RUN echo "4fecdcf45f74390d1f5cc1f324b36490f9fc42f55456313a9ec40ed4cf89a381  jarvis_agent_release_v209.py" | sha256sum -c -
RUN python jarvis_agent_release_v209.py
RUN python -m compileall -q app jarvis_boot.py
RUN grep -q "CURRENT_RELEASE='209.0.0'" jarvis_boot.py
RUN grep -Fq 'CURRENT_RELEASE = "209.0.0"' app/runtime_overlay.py
RUN grep -q "ACTIVE_RELEASE_FILE = 'jarvis_agent_release_v209.py'" app/self_maintenance.py
RUN grep -q "/agent/v209/command" app/agent_console.py
RUN grep -q "v209</span>" app/agent_console.py
RUN grep -q "security_audit_fallback.jsonl" app/security.py
RUN grep -q "timeout=0.35" app/security.py
RUN grep -q "PRAGMA journal_mode=WAL" app/db.py
RUN grep -q "X-Jarvis-Version']='209.0.0'" app/main.py
RUN grep -q "Marin" app/agent_console.py
CMD ["python", "jarvis_boot.py"]
