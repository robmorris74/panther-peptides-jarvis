FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVIS_DATA_DIR=/var/data \
    DATABASE_PATH=/var/data/operator.db \
    JARVIS_CONFIG_PATH=/var/data/jarvis.env \
    JARVIS_KEY_PATH=/var/data/jarvis.key \
    JARVIS_SESSION_DB=/var/data/jarvis_sessions.db \
    JARVIS_AGENT_POLL_SECONDS=12 \
    JARVIS_AGENT_MAX_STEPS_PER_WAKE=4

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY jarvis_agent_release_v203.py .
RUN echo "30a93b1142ee45a5245eca9e187b73e490eaf4e3786322ae3556dc31e680260e  jarvis_agent_release_v203.py" | sha256sum -c -
RUN python jarvis_agent_release_v203.py
RUN python -m compileall -q app jarvis_boot.py
RUN grep -q "ACTIVE_RELEASE_FILE = 'jarvis_agent_release_v203.py'" app/self_maintenance.py
RUN grep -q "persistent_runtime_overlay" app/self_maintenance.py
RUN grep -q "github_required_for_activation.*False" app/self_maintenance.py
RUN grep -q "/agent/v203/command" app/agent_console.py
RUN grep -q "Marin" app/agent_console.py
CMD ["python", "jarvis_boot.py"]
