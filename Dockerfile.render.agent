FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 JARVIS_DATA_DIR=/var/data DATABASE_PATH=/var/data/operator.db JARVIS_SESSION_SECRET_FILE=/var/data/jarvis_session_secret JARVIS_MODEL=gpt-5-mini JARVIS_MODEL_FALLBACK=gpt-5-mini JARVIS_TTS_MODEL=gpt-4o-mini-tts JARVIS_TTS_VOICE=onyx JARVIS_COOKIE_SECURE=1 JARVIS_MAX_STEPS=60 JARVIS_MAX_APPROVED_SPEND=300 RAMP_ENV=production JARVIS_RELEASE=229.0.0
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir fastapi uvicorn python-multipart pypdf
COPY app223 ./app223
COPY jarvis_boot.py ./jarvis_boot.py
RUN python -m compileall -q app223 jarvis_boot.py
RUN grep -Fq "VER='229.0.0'" app223/main.py
RUN grep -Fq 'execution_first_v229' app223/agent.py
RUN grep -Fq 'objective_steps' app223/agent.py
RUN grep -Fq 'A prose answer is not completion' app223/agent.py
RUN grep -Fq 'verification_after_mutation' app223/agent.py
RUN grep -Fq '/agent/objectives/{objective_id}/steps' app223/main.py
RUN grep -Fq '_safe_component' app223/main.py
RUN grep -Fq 'resilient mode' app223/business_ui.py
RUN grep -Fq '/business/dashboard' app223/main.py
RUN grep -Fq 'FOR RESEARCH USE ONLY' app223/main.py
RUN grep -Fq 'SpeechRecognition' app223/ui.py
RUN grep -Fq 'journal_mode=WAL' app223/db.py
CMD ["python","jarvis_boot.py"]
