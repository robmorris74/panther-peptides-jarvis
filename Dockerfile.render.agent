FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVIS_DATA_DIR=/app/data \
    DATABASE_PATH=/app/data/operator.db \
    JARVIS_SESSION_DB=/app/data/jarvis_sessions.db \
    JARVIS_SESSION_SECRET_FILE=/app/data/jarvis_session_secret \
    JARVIS_MODEL=gpt-5-mini \
    JARVIS_MODEL_FALLBACK=gpt-5-mini \
    JARVIS_TTS_MODEL=gpt-4o-mini-tts \
    JARVIS_TTS_VOICE=onyx \
    JARVIS_COOKIE_SECURE=1 \
    JARVIS_MAX_STEPS=60 \
    JARVIS_MAX_APPROVED_SPEND=300 \
    RAMP_ENV=production \
    JARVIS_RELEASE=230.0.0
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir fastapi uvicorn python-multipart pypdf
COPY app223 ./app223
COPY jarvis_boot.py ./jarvis_boot.py
RUN mkdir -p /app/data && python -m compileall -q app223 jarvis_boot.py
RUN grep -Fq "VER='230.0.0'" app223/main.py \
 && grep -Fq 'execution_first_v229' app223/agent.py \
 && grep -Fq 'objective_steps' app223/agent.py \
 && grep -Fq 'A prose answer is not completion' app223/agent.py \
 && grep -Fq 'verification_after_mutation' app223/agent.py \
 && grep -Fq '/agent/objectives/{objective_id}/steps' app223/main.py \
 && grep -Fq '_safe_component' app223/main.py \
 && grep -Fq 'resilient mode' app223/business_ui.py \
 && grep -Fq '/business/dashboard' app223/main.py \
 && grep -Fq 'FOR RESEARCH USE ONLY' app223/main.py \
 && grep -Fq 'SpeechRecognition' app223/ui.py \
 && grep -Fq 'journal_mode=WAL' app223/db.py
EXPOSE 8000
CMD ["python","jarvis_boot.py"]
