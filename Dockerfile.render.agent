FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVIS_DATA_DIR=/var/data \
    DATABASE_PATH=/var/data/operator.db \
    JARVIS_SESSION_SECRET_FILE=/var/data/jarvis_session_secret \
    JARVIS_MODEL=gpt-5-mini \
    JARVIS_MODEL_FALLBACK=gpt-5-mini \
    JARVIS_TTS_MODEL=gpt-4o-mini-tts \
    JARVIS_TTS_VOICE=onyx \
    JARVIS_TTS_INSTRUCTIONS="Adult British male voice. Polished modern received-pronunciation English accent, lower male register, calm and assured, warm but restrained, articulate, intelligent personal aide. Natural conversational cadence with subtle dry confidence. Never feminine, never high-pitched, never robotic, never announcer-like. Do not sound American." \
    JARVIS_COOKIE_SECURE=1 \
    JARVIS_MAX_STEPS=30
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir fastapi uvicorn python-multipart pypdf
COPY app223 ./app223
COPY jarvis_boot.py ./jarvis_boot.py
RUN python -m compileall -q app223 jarvis_boot.py
RUN grep -Fq "VER='225.0.0'" app223/main.py
RUN grep -Fq '/assistant/message' app223/main.py
RUN grep -Fq '/voice/tts' app223/main.py
RUN grep -Fq '/business/dashboard' app223/main.py
RUN grep -Fq '/business/inventory/{inventory_id}/documents' app223/main.py
RUN grep -Fq '/business/inventory/{inventory_id}/release' app223/main.py
RUN grep -Fq 'pp_inventory_documents' app223/business.py
RUN grep -Fq 'FOR RESEARCH USE ONLY' app223/main.py
RUN grep -Fq 'SpeechRecognition' app223/ui.py
RUN grep -Fq '/agent/v223/command' app223/main.py
RUN grep -Fq '/model/test' app223/main.py
RUN ! grep -Fq "'temperature'" app223/agent.py
RUN grep -Fq 'gpt-5-mini' app223/agent.py
RUN grep -Fq 'persistent_legacy_hash' app223/security.py
RUN grep -Fq 'jarvis223-supervisor' app223/agent.py
RUN grep -Fq 'journal_mode=WAL' app223/db.py
CMD ["python","jarvis_boot.py"]
