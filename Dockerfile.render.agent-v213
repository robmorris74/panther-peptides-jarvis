FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVIS_DATA_DIR=/var/data \
    DATABASE_PATH=/var/data/operator.db \
    JARVIS_CONFIG_PATH=/var/data/jarvis.env \
    JARVIS_KEY_PATH=/var/data/jarvis.key \
    JARVIS_SESSION_DB=/var/data/jarvis_sessions.db \
    JARVIS_SESSION_SECRET_FILE=/var/data/jarvis_session_secret \
    JARVIS_AGENT_POLL_SECONDS=12 \
    JARVIS_AGENT_MAX_STEPS_PER_WAKE=1 \
    JARVIS_SQLITE_BUSY_TIMEOUT_MS=60000 \
    JARVIS_SQLITE_WRITE_RETRIES=12

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY jarvis_agent_release_v213.py .
RUN echo "f41a5093ab867972692ddc9fd1442bed8090a1c86d72f84de92bdccf52f9b572  jarvis_agent_release_v213.py" | sha256sum -c -
RUN python jarvis_agent_release_v213.py
RUN python -m compileall -q app jarvis_boot.py
RUN grep -Fq "CURRENT_RELEASE='213.0.0'" jarvis_boot.py
RUN grep -Fq 'CURRENT_RELEASE = "213.0.0"' app/runtime_overlay.py
RUN grep -Fq "ACTIVE_RELEASE_FILE = 'jarvis_agent_release_v213.py'" app/self_maintenance.py
RUN grep -Fq '/agent/v213/command' app/agent_console.py
RUN grep -Fq 'v213</span>' app/agent_console.py
RUN grep -Fq "version='213.0.0'" app/main.py
RUN grep -Fq "X-Jarvis-Version']='213.0.0'" app/main.py
RUN grep -Fq 'statusFailures<3' app/agent_console.py
RUN grep -Fq "$('worker').textContent='Restarting…'" app/agent_console.py
RUN grep -Fq "$('worker').textContent='Status delayed'" app/agent_console.py
RUN grep -Fq 'if(!s.worker_alive&&!recoveryInFlight)' app/agent_console.py
RUN grep -Fq 'good>=2' app/agent_console.py
CMD ["python", "jarvis_boot.py"]
